# Copy this file to .env and fill in your keys. Never commit .env.

# AI runs on two free providers. Add one key or both. Keys can also be added in the app, under
# Settings, where the first provider, the models and the strategy are chosen too.
#
# Groq: all AI, speech to text, and the English voice. Free key at https://console.groq.com
GROQ_API_KEY=your-groq-key

# Google Gemini: text and images only. Free key at https://aistudio.google.com/apikey
# With both keys set, Gemini answers when Groq fails. Settings can make them take turns instead.
# Gemini's free plan may use content to improve Google's products, so use synthetic data only.
GEMINI_API_KEY=your-gemini-key

# Any OpenAI-compatible service can stand in for either one, such as a local model server.
# AI_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Where original clinical documents are kept. Put this on an encrypted disk.
# DIAGNOSIA_DOCUMENTS=backend/storage/documents

# development, staging or production. Anything else is treated as production.
# DIAGNOSIA_ENV=development

# The document encryption key ring. Stored files are refused until this is set.
# Create it with: python -m backend.operator_cli generate-key --path ~/.diagnosia/document-keys.json
# It must live outside this repository and away from stored documents.
# DIAGNOSIA_DOCUMENT_KEY_FILE=

# Safety switches. Leave these alone unless backend/safety.py's checks all pass.
# CLINICAL_PILOT_MODE=1
# ALLOW_REAL_PATIENT_DATA=0
# ENABLE_UNVALIDATED_CLINICAL_RULES=0
# ENABLE_EXTERNAL_MESSAGING=0

# Set to 1 in production, so session cookies are only sent over HTTPS
# DIAGNOSIA_HTTPS=1
