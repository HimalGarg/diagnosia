# Copy this file to .env and fill in your keys. Never commit .env.

# AI runs on two free providers. Add one key or both. Keys can also be added in the app, under
# Settings, where the first provider, the models and the strategy are chosen too.
#
# Groq: all AI, speech to text, and the English voice. Free key at https://console.groq.com
GROQ_API_KEY=your-groq-key

# Google Gemini: text and images only. Free key at https://aistudio.google.com/apikey
# With both keys set, Gemini answers when Groq fails. Settings can make them take turns instead.
# Gemini's free plan may use content to improve Google's products, so use synthetic data only.
GEMINI_API_KEY=your-gemini-key

# Any OpenAI-compatible service can stand in for either one, such as a local model server.
# AI_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional integrations. All are off unless set to 1, and the app runs without any of them.
# They work with synthetic data only: with real patient data allowed, CareFlow records nothing.
# Setup guides are in docs/integrations/. Keys and addresses stay on the server.
# DIAGNOSIA_DEMO_MODE=1

# MongoDB Atlas: the CareFlow event store and timeline.
# ENABLE_MONGODB_ATLAS_INTEGRATION=false
# MONGODB_ATLAS_URI=
# MONGODB_DATABASE_NAME=diagnosia_atlas
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# Instant CareFlow updates. Needs a replica set, which Atlas clusters are. Screens poll without it.
# ENABLE_MONGODB_CHANGE_STREAMS=false
# MONGODB_CHANGE_STREAM_COLLECTION=care_events

# YugabyteDB: technical AI run and handoff records. A cluster of your own, never Meko's.
# ENABLE_YUGABYTEDB_INTEGRATION=false
# YUGABYTEDB_YSQL_DSN=
# YUGABYTEDB_POOL_MAX_SIZE=4

# Meko: shared agent context, through its MCP server.
# ENABLE_MEKO_INTEGRATION=false
# MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
# MEKO_API_KEY=
# MEKO_DATAPACK_ID=
# Patient packs: one Meko datapack per patient. Made-up patients only. See docs/integrations/PATIENT_PACKS.md.
# ENABLE_MEKO_PATIENT_PACKS=false
# MEKO_PACK_LIMIT=6

# How the worker retries a destination that is down.
# EVENT_DELIVERY_BATCH_SIZE=50
# EVENT_DELIVERY_MAX_ATTEMPTS=8
# EVENT_DELIVERY_BACKOFF_SECONDS=30

# Where original clinical documents are kept. Put this on an encrypted disk.
# DIAGNOSIA_DOCUMENTS=backend/storage/documents

# development, staging or production. Anything else is treated as production.
# DIAGNOSIA_ENV=development

# The document encryption key ring. Stored files are refused until this is set.
# Create it with: python -m backend.operator_cli generate-key --path ~/.diagnosia/document-keys.json
# It must live outside this repository and away from stored documents.
# DIAGNOSIA_DOCUMENT_KEY_FILE=

# Safety switches. Leave these alone unless backend/safety.py's checks all pass.
# CLINICAL_PILOT_MODE=1
# ALLOW_REAL_PATIENT_DATA=0
# ENABLE_EXTERNAL_MESSAGING=0

# Set to 1 in production, so session cookies are only sent over HTTPS
# DIAGNOSIA_HTTPS=1
